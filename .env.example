# Copy to .env (ignored by git) and fill in. NEVER commit real values.
# Meta Model API key (https://dev.meta.ai). Official env var name used in Meta docs.
MODEL_API_KEY=
# Alternative accepted name (used only if MODEL_API_KEY is empty)
# META_API_KEY=

